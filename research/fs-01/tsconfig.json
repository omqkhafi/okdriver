{
  // FS-01 research only. Not part of the root solution; `bun run typecheck` does not build this.
  // Run with: bunx tsc -p research/fs-01/tsconfig.json
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["bun"],
    "typeRoots": ["../../node_modules/@types", "../../node_modules"]
  },
  "include": ["./src/**/*.ts", "./scripts/**/*.ts"]
}
